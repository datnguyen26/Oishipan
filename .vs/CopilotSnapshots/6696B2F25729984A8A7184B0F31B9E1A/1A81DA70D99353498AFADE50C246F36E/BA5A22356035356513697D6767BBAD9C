:root {
    --primary-green: #1a4332;
    --active-green: #4f8a61;
    --text-gray: #666666;
    --bg-header: #fcfaf6;
    --max-width: 1300px;
}

html {
    font-size: 14px;
    scroll-behavior: smooth;
}

@media (min-width: 768px) {
    html {
        font-size: 16px;
    }
}

html {
    position: relative;
    min-height: 100%;
}

body {
    margin-bottom: 60px;
    font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fff;
    color: #333;
}

.container-custom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    white-space: nowrap;
    line-height: 60px;
}

/* ============ NAVBAR ============ */
.navbar {
    background-color: var(--bg-header);
    padding: 0.7rem 0;
    border-bottom: 1px solid #f0efeb;
}

.navbar-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: #000 !important;
    font-weight: 700;
    display: flex;
    align-items: center;
    margin-right: 3rem;
}

.navbar-brand img {
    height: 30px;
    margin-right: 10px;
}

.navbar-nav .nav-link {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-gray) !important;
    padding: 0.5rem 1rem !important;
    transition: 0.2s;
}

.navbar-nav .nav-link.active {
    color: var(--active-green) !important;
}

.navbar-nav .nav-link:hover {
    color: var(--active-green) !important;
}

/* Right side actions */
.header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.cart-btn {
    color: #333;
    text-decoration: none;
    font-size: 1.2rem;
    position: relative;
}

.btn-login {
    background-color: var(--primary-green);
    color: #fff !important;
    border-radius: 50px;
    padding: 7px 22px;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: 0.3s;
}

.btn-login:hover {
    background-color: #245a43;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(26, 67, 50, 0.3);
}

/* ============ HERO BANNER ============ */
.hero-container {
    padding: 40px 0;
}

.hero-banner {
    background: linear-gradient(135deg, rgba(26, 67, 50, 0.5) 0%, rgba(79, 138, 97, 0.3) 100%),
                url('https://images.unsplash.com/photo-1517433367423-c7e5b0f35086?auto=format&fit=crop&q=80&w=1200');
    background-size: cover;
    background-position: center;
    height: 500px;
    border-radius: 30px;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 80px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
}

.hero-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    color: #fff;
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.hero-content p {
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 2rem;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
}

/* ============ PROMOTIONAL SECTION ============ */
.promo-section {
    padding: 40px 0;
    background-color: #f8f9fa;
}

.promo-card {
    position: relative;
    height: 250px;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 40px;
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.promo-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
}

.promo-card img {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    object-fit: cover;
    width: 50%;
    z-index: 1;
}

.promo-content {
    position: relative;
    z-index: 2;
    width: 50%;
}

.promo-primary {
    background: linear-gradient(135deg, #1a4332 0%, #4f8a61 100%);
}

.promo-secondary {
    background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
}

.promo-content h3 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.promo-content p {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
}

.btn-promo {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 10px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    border: 2px solid white;
    transition: all 0.3s;
}

.btn-promo:hover {
    background-color: white;
    color: #1a4332;
}

/* ============ CATEGORIES SECTION ============ */
.category-section {
    padding: 50px 0;
    background-color: #fff;
}

.category-item {
    text-align: center;
    text-decoration: none;
    color: #333;
    display: block;
}

.category-icon-box {
    width: 70px;
    height: 70px;
    background-color: #f9f8f4;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    transition: all 0.3s;
}

.category-item:hover .category-icon-box {
    background-color: #e8f5e9;
    transform: translateY(-8px);
    box-shadow: 0 8px 16px rgba(26, 67, 50, 0.15);
}

.category-item span {
    font-size: 0.9rem;
    font-weight: 600;
}

/* ============ FEATURES SECTION ============ */
.features-section {
    background-color: #f8f9fa;
    padding: 60px 0;
}

.feature-card {
    background-color: #fff;
    border-radius: 12px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid #f0f0f0;
}

.feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
}

/* ============ PRODUCTS SECTION ============ */
.products-section {
    background-color: #fff;
    padding: 60px 0;
}

.product-card {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15) !important;
}

.product-card img {
    height: 300px;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-card:hover img {
    transform: scale(1.05);
}

/* ============ ABOUT SECTION ============ */
.about-section {
    background-color: #f8f9fa;
    padding: 80px 0;
}

.about-img {
    border-radius: 12px;
    transition: transform 0.3s ease;
}

.about-section:hover .about-img {
    transform: translateY(-5px);
}

.stat-box {
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    border-left: 4px solid #1a4332;
}

/* ============ CONTACT SECTION ============ */
.contact-section {
    background-color: #fff;
    padding: 60px 0;
}

.contact-card {
    background-color: #f8f9fa;
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 1px solid #f0f0f0;
}

.contact-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(26, 67, 50, 0.15);
    background-color: #f0f9f6;
}

.contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background-color: #e8f5e9;
    border-radius: 50%;
    margin: 0 auto;
}

/* ============ BUTTONS ============ */
.btn-success {
    background-color: #198754;
    border-color: #198754;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-success:hover {
    background-color: #157347;
    border-color: #157347;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
}

.btn-outline-success {
    color: #198754;
    border-color: #198754;
    font-weight: 600;
}

.btn-outline-success:hover {
    background-color: #198754;
    border-color: #198754;
}

.rounded-lg {
    border-radius: 12px;
}

/* ============ UTILITIES ============ */
.fw-500 {
    font-weight: 500;
}

.text-muted {
    color: #6c757d;
}

.shadow-sm {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.hover-shadow:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 991px) {
    .navbar-brand { 
        margin-right: 1rem; 
    }

    .hero-banner { 
        padding: 30px;
        height: 350px;
    }

    .hero-content h2 { 
        font-size: 2.5rem; 
    }

    .hero-content p {
        font-size: 1rem;
    }

    .promo-card {
        height: auto;
        flex-direction: column;
        padding: 30px;
    }

    .promo-card img {
        position: relative;
        width: 100%;
        height: 200px;
        margin-top: 20px;
    }

    .promo-content {
        width: 100%;
    }

    .about-img {
        margin-bottom: 30px;
    }
}
