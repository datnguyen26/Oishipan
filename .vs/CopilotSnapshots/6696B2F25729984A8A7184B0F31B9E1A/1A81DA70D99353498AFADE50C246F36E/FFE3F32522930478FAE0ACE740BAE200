                                <i class="bi bi-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5">
    <div class="container-fluid px-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1516975080664-ed2fc6a32937?auto=format&fit=crop&q=80&w=500" alt="Về Oishipan" class="img-fluid rounded-3">
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Về Oishipan</h2>
                <p class="text-muted mb-3">Oishipan là tiệm bánh chuyên phục vụ các loại bánh nhập khẩu từ Nhật Bản với chất lượng cao nhất. Chúng tôi cam kết mang đến cho khách hàng những sản phẩm tươi ngon, an toàn và đáng tin cậy.</p>
                <p class="text-muted mb-4">Với hơn 5 năm kinh nghiệm trong ngành, Oishipan đã phục vụ hàng ngàn khách hàng thân thiết và luôn nhận được lời khen từ cộng đồng.</p>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Sản phẩm chất lượng cao</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Giao hàng nhanh chóng</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Dịch vụ khách hàng 24/7</li>
                </ul>
            </div>
        </div>
    </div>
</section>

