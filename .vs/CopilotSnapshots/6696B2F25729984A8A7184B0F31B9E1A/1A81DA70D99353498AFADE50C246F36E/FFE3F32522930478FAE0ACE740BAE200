                    </div>
                    <h5 class="fw-bold">Điện thoại</h5>
                    <p class="text-muted">(84+) 123 456 789</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle d-inline-flex mb-3" style="width: 70px; height: 70px; align-items: center; justify-content: center;">
                        <i class="bi bi-envelope-fill text-success fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Email</h5>
                    <p class="text-muted">contact@oishipan.com</p>
                </div>
            </div>
        </div>
    </div>
</section>
