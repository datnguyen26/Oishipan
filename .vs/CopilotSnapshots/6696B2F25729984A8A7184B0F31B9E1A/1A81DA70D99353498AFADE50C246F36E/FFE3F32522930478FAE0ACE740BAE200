                        <h5 class="card-title fw-bold">Bánh Donut Nhân Cream</h5>
                        <p class="card-text text-muted small">Bánh donut mềm với cream béo</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-success">45.000₫</span>
                            <button class="btn btn-success btn-sm rounded-circle">
                                <i class="bi bi-cart-plus"></i>
