@page
@model OishipanMVC.Pages.IndexModel
@{
    ViewData["Title"] = "Oishipan - Tiệm Bánh Ngọt Cao Cấp";
}

<!-- Hero Banner Section -->
<section class="hero py-5" style="background: linear-gradient(135deg, #1a4332 0%, #4f8a61 100%); color: white; min-height: 500px; display: flex; align-items: center;">
    <div class="container-fluid px-4">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-3">BST <span class="text-warning">"MẤN NHÂN"</span></h1>
                <p class="lead mb-4">Tiệc hè thêm vui cùng hương vị bánh Nhật - Chất lượng cao, hương vị tinh tế</p>
                <a href="#products" class="btn btn-warning btn-lg me-3">
                    <i class="bi bi-bag-check me-2"></i>Khám phá ngay
                </a>
                <a href="#contact" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-telephone me-2"></i>Liên hệ
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&q=80&w=500" alt="Bánh Mẫn Nhân" class="img-fluid rounded-lg" style="max-width: 400px;">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 bg-light">
    <div class="container-fluid px-4">
        <h5 class="fw-bold mb-4">Danh Mục Sản Phẩm</h5>
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-cake2 text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Bánh Kem</p>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-box2-heart text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Quà Tặng</p>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-flower1 text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Mùa Hè</p>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-gift text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Đặc Biệt</p>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-star text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Bán Chạy</p>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="text-center">
                    <div class="bg-white p-3 rounded-3 mb-2" style="cursor: pointer;">
                        <i class="bi bi-heart text-success fs-2"></i>
                    </div>
                    <p class="fw-500 small">Yêu Thích</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container-fluid px-4">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-star-fill text-warning fs-1 mb-3"></i>
                    <h5 class="fw-bold">Chất lượng cao</h5>
                    <p class="text-muted">Nguyên liệu nhập khẩu từ Nhật Bản</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-truck text-success fs-1 mb-3"></i>
                    <h5 class="fw-bold">Giao hàng nhanh</h5>
                    <p class="text-muted">Miễn phí trên 200K</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <i class="bi bi-shield-check text-info fs-1 mb-3"></i>
                    <h5 class="fw-bold">An toàn & Uy tín</h5>
                    <p class="text-muted">Chứng chỉ vệ sinh an toàn</p>
                </div>
            </div>
        </div>
    </div>
</section>

