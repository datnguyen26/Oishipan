:root {
    --primary-green: #1a4332;
    --active-green: #4f8a61;
    --text-gray: #666666;
    --bg-header: #fcfaf6;
    --max-width: 1300px;
}

html {
    font-size: 14px;
}

@media (min-width: 768px) {
    html {
        font-size: 16px;
    }
}

html {
    position: relative;
    min-height: 100%;
}

body {
    margin-bottom: 60px;
    font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fff;
    color: #333;
}

.container-custom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    white-space: nowrap;
    line-height: 60px;
}

/* ============ NAVBAR ============ */
.navbar {
    background-color: var(--bg-header);
    padding: 0.7rem 0;
    border-bottom: 1px solid #f0efeb;
}

.navbar-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: #000 !important;
    font-weight: 700;
    display: flex;
    align-items: center;
    margin-right: 3rem;
}

.navbar-brand img {
    height: 30px;
    margin-right: 10px;
}

.navbar-nav .nav-link {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-gray) !important;
    padding: 0.5rem 1rem !important;
    transition: 0.2s;
}

.navbar-nav .nav-link.active {
    color: var(--active-green) !important;
}

.navbar-nav .nav-link:hover {
    color: var(--active-green) !important;
}

/* Right side actions */
.header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.cart-btn {
    color: #333;
    text-decoration: none;
    font-size: 1.2rem;
    position: relative;
}

.btn-login {
    background-color: var(--primary-green);
    color: #fff !important;
    border-radius: 50px;
    padding: 7px 22px;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: 0.3s;
}

.btn-login:hover {
    background-color: #245a43;
    opacity: 0.9;
}

/* ============ HERO BANNER ============ */
.hero-container {
    padding: 30px 0;
}

.hero-banner {
    background: linear-gradient(to right, rgba(255,255,255,0.7) 30%, transparent), 
                url('https://images.unsplash.com/photo-1517433367423-c7e5b0f35086?auto=format&fit=crop&q=80&w=2400');
    background-size: cover;
    background-position: center;
    height: 480px;
    border-radius: 40px;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 80px;
}

.hero-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    color: var(--primary-green);
    margin-bottom: 1rem;
}

.hero-content p {
    font-size: 1.2rem;
    color: #444;
    margin-bottom: 2rem;
}

/* ============ CATEGORIES SECTION ============ */
.category-section {
    padding: 40px 0;
    background-color: #fff;
}

.category-item {
    text-align: center;
    text-decoration: none;
    color: #333;
    display: block;
}

.category-icon-box {
    width: 70px;
    height: 70px;
    background-color: #f9f8f4;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    transition: 0.3s;
}

.category-item:hover .category-icon-box {
    background-color: #e8edea;
    transform: translateY(-5px);
}

.category-item span {
    font-size: 0.9rem;
    font-weight: 600;
}

/* ============ FEATURES SECTION ============ */
.features-section {
    background-color: #f8f9fa;
}

.feature-card {
    background-color: #fff;
    border-radius: 12px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

/* ============ PRODUCTS SECTION ============ */
.products-section {
    background-color: #fff;
}

.product-card {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
}

.product-card img {
    height: 300px;
    object-fit: cover;
}

/* ============ ABOUT SECTION ============ */
.about-section {
    background-color: #f8f9fa;
}

.about-section img {
    max-height: 450px;
    object-fit: cover;
    border-radius: 12px;
}

/* ============ CONTACT SECTION ============ */
.contact-section {
    background-color: #fff;
}

.contact-card {
    background-color: #f8f9fa;
    border-radius: 12px;
    transition: transform 0.3s ease;
}

.contact-card:hover {
    transform: translateY(-5px);
}

/* ============ BUTTONS ============ */
.btn-success {
    background-color: #198754;
    border-color: #198754;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-success:hover {
    background-color: #157347;
    border-color: #157347;
    transform: translateY(-2px);
}

.btn-outline-success {
    color: #198754;
    border-color: #198754;
    font-weight: 600;
}

.btn-outline-success:hover {
    background-color: #198754;
    border-color: #198754;
}

.rounded-lg {
    border-radius: 12px;
}

/* ============ UTILITIES ============ */
.fw-500 {
    font-weight: 500;
}

.text-muted {
    color: #6c757d;
}

.shadow-sm {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.hover-shadow:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 991px) {
    .navbar-brand { 
        margin-right: 1rem; 
    }

    .hero-banner { 
        padding: 0 30px; 
        height: 350px; 
    }

    .hero-content h2 { 
        font-size: 2.5rem; 
    }

    .hero-content p {
        font-size: 1rem;
    }
}
