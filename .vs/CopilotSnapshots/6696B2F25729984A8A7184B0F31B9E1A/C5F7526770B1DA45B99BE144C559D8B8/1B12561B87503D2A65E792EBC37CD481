html {
    font-size: 14px;
}

@media (min-width: 768px) {
    html {
        font-size: 16px;
    }
}

html {
    position: relative;
    min-height: 100%;
}

body {
    margin-bottom: 60px;
    font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fafafa;
}

.container-custom {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
}

footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    white-space: nowrap;
    line-height: 60px;
}

.card {
    transition: box-shadow 0.3s ease-in-out;
}

.card:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.jumbotron {
    background-color: #f8f9fa;
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 0.5rem;
}

/* ============ NAVBAR ============ */
.navbar {
    background-color: #fff;
    border-bottom: 1px solid #e0e0e0;
}

.navbar-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: #198754 !important;
}

.nav-link {
    font-weight: 500;
    color: #333 !important;
    transition: color 0.3s ease;
}

.nav-link:hover {
    color: #198754 !important;
}

/* ============ HERO SECTION ============ */
.hero-section {
    background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
    padding: 60px 0;
}

.hero-section h1 {
    color: #198754;
    line-height: 1.3;
}

.hero-section .text-warning {
    color: #ffc107 !important;
}

.hero-section img {
    max-height: 400px;
    object-fit: cover;
}

/* ============ FEATURES SECTION ============ */
.features-section {
    background-color: #f8f9fa;
}

.feature-card {
    background-color: #fff;
    border-radius: 12px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

/* ============ PRODUCTS SECTION ============ */
.products-section {
    background-color: #fff;
}

.product-card {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
}

.product-card img {
    height: 300px;
    object-fit: cover;
}

.hover-shadow:hover {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
}

/* ============ ABOUT SECTION ============ */
.about-section {
    background-color: #f8f9fa;
}

.about-section img {
    max-height: 450px;
    object-fit: cover;
}

/* ============ CONTACT SECTION ============ */
.contact-section {
    background-color: #fff;
}

.contact-card {
    background-color: #f8f9fa;
    border-radius: 12px;
    transition: transform 0.3s ease;
}

.contact-card:hover {
    transform: translateY(-5px);
}

/* ============ BUTTONS ============ */
.btn-success {
    background-color: #198754;
    border-color: #198754;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-success:hover {
    background-color: #157347;
    border-color: #157347;
    transform: translateY(-2px);
}

.btn-outline-success {
    color: #198754;
    border-color: #198754;
    font-weight: 600;
}

.btn-outline-success:hover {
    background-color: #198754;
    border-color: #198754;
}

.rounded-lg {
    border-radius: 12px;
}

/* ============ UTILITIES ============ */
.fw-500 {
    font-weight: 500;
}

.text-muted {
    color: #6c757d;
}

.shadow-sm {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}
