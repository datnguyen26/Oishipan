@model IEnumerable<OishipanMVC.Models.ProductViewModel>

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="container-fluid">
    <div class="dashboard-grid mb-4">
        <div class="metric-card p-4 shadow-sm">
            <div class="metric-label">Sản phẩm</div>
            <div class="metric-value">@ViewBag.ProductCount</div>
            <p class="metric-description">Tổng số sản phẩm đang quản lý</p>
        </div>
        <div class="metric-card p-4 shadow-sm">
            <div class="metric-label">Đơn hàng</div>
            <div class="metric-value">@ViewBag.OrderCount</div>
            <p class="metric-description">Đơn hàng đang được xử lý</p>
        </div>
        <div class="metric-card p-4 shadow-sm">
            <div class="metric-label">Khách hàng</div>
            <div class="metric-value">@ViewBag.CustomerCount</div>
            <p class="metric-description">Khách hàng giao dịch hôm nay</p>
        </div>
        <div class="metric-card p-4 shadow-sm">
            <div class="metric-label">Doanh thu</div>
            <div class="metric-value">@(((decimal)ViewBag.TotalRevenue).ToString("N0"))₫</div>
            <p class="metric-description">Tổng doanh thu từ đơn hàng</p>
        </div>
    </div>

    <div class="card admin-panel-card shadow-sm border-0 rounded-4 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-semibold">Danh sách sản phẩm mới nhất</h4>
                <p class="text-muted mb-0">Kiểm tra và quản lý sản phẩm trực tiếp từ API.</p>
            </div>
            <a href="/admin/products" class="btn btn-success rounded-pill px-4">Xem toàn bộ sản phẩm</a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-secondary">Không có sản phẩm để hiển thị. Hãy đảm bảo API đang chạy hoặc thêm sản phẩm mới.</div>
        }
        else
        {
            <div class="table-responsive dashboard-table">
                <table class="table align-middle table-dark table-admin">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Take(5))
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("N0")₫</td>
                                <td>@product.CategoryName</td>
                                <td>@product.BrandName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card admin-panel-card shadow-sm border-0 rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-semibold">Đơn hàng gần đây</h4>
                <p class="text-muted mb-0">Theo dõi những đơn mới nhất và trạng thái cập nhật.</p>
            </div>
            <a href="/admin/orders" class="btn btn-outline-light rounded-pill px-4">Xem tất cả đơn hàng</a>
        </div>

        @{
            var recentOrders = ViewBag.RecentOrders as List<AdminOrderDto> ?? new List<AdminOrderDto>();
        }

        @if (!recentOrders.Any())
        {
            <div class="alert alert-secondary">Chưa có đơn hàng mới để hiển thị.</div>
        }
        else
        {
            <div class="table-responsive dashboard-table">
                <table class="table align-middle table-dark table-admin">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Giá trị</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>Khách #@order.UserId</td>
                                <td>@order.TotalAmount.ToString("N0")₫</td>
                                <td><span class="badge badge-status badge-@order.Status.ToLower().Replace(" ", "-")">@order.Status</span></td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
