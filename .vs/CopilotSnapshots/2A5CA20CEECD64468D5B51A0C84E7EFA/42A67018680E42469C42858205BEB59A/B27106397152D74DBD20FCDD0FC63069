@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oishipan Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin-modern.css" asp-append-version="true" />
</head>
<body class="admin-modern-theme">
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Logo -->
            <div class="sidebar-header">
                <a href="/admin" class="sidebar-logo">
                    <div class="logo-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </div>
                    <span class="logo-text">Gemini Admin</span>
                </a>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <a href="/admin" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/products" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                    <i class="bi bi-bag-dash-fill"></i>
                    <span>Sản phẩm</span>
                </a>
                <a href="/admin/categories" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="bi bi-tags-fill"></i>
                    <span>Danh mục</span>
                </a>
                <a href="/admin/brands" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Brands" ? "active" : "")">
                    <i class="bi bi-award-fill"></i>
                    <span>Thương hiệu</span>
                </a>
                <a href="/admin/orders" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Đơn hàng</span>
                </a>
                <a href="/admin/users" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>Người dùng</span>
                </a>
            </nav>

            <!-- Footer -->
            <div class="sidebar-footer">
                <div class="user-profile">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" alt="Admin" class="user-avatar">
                    <div>
                        <p class="user-name">Admin User</p>
                        <p class="user-role">Quản trị viên</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Top Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
                <div class="header-right">
                    <button class="btn-icon" id="themeToggle" title="Chuyển chế độ giao diện">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>
                    <button class="btn-icon" title="Thông báo">
                        <i class="bi bi-bell-fill"></i>
                        <span class="notification-badge"></span>
                    </button>
                    <div class="divider"></div>
                    <div class="header-profile">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100&q=80" alt="Admin" class="profile-avatar">
                        <span>Admin</span>
                    </div>
                    <a href="/Account/Logout" class="btn-logout" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-modern.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
