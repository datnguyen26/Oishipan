@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Oishipan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin-new.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <aside class="admin-sidebar p-4 col-auto">
            <div class="mb-5">
                <a href="/admin" class="text-decoration-none">
                    <h4 class="text-white fw-bold"><i class="bi bi-speedometer2 me-2"></i>Admin</h4>
                </a>
            </div>
            <nav class="nav flex-column gap-2">
                <a class="nav-link px-3 py-2 rounded-3 active" href="/admin"><i class="bi bi-house-door me-2"></i>Bảng điều khiển</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/admin/products"><i class="bi bi-basket3 me-2"></i>Quản lý sản phẩm</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/admin/categories"><i class="bi bi-tags me-2"></i>Quản lý danh mục</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/admin/brands"><i class="bi bi-award me-2"></i>Quản lý thương hiệu</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/admin/orders"><i class="bi bi-receipt me-2"></i>Quản lý đơn hàng</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/admin/users"><i class="bi bi-people me-2"></i>Quản lý người dùng</a>
                <a class="nav-link px-3 py-2 rounded-3" href="/san-pham"><i class="bi bi-box-arrow-left me-2"></i>Về trang khách</a>
            </nav>
        </aside>
        <div class="flex-fill">
            <header class="admin-topbar d-flex justify-content-between align-items-center px-4 py-3 shadow-sm">
                <div>
                    <h2 class="h5 mb-0">@ViewData["Title"]</h2>
                    <p class="text-muted mb-0">Khu vực quản trị Oishipan</p>
                </div>
                <div>
                    <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-house-door"></i> Xem trang chủ</a>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
