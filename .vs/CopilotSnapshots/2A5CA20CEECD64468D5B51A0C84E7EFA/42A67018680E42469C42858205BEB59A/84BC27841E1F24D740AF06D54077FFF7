@model IEnumerable<OishipanMVC.Models.ProductViewModel>

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Quick Stats -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-icon">
            <i class="bi bi-bag-dash-fill"></i>
        </div>
        <div class="stat-label">Sản phẩm</div>
        <div class="stat-value">@ViewBag.ProductCount</div>
        <p class="stat-desc">Tổng số sản phẩm đang quản lý</p>
        <div class="stat-trend up">
            <i class="bi bi-arrow-up-right-circle-fill"></i>
            <span>+5 mới</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="bi bi-receipt"></i>
        </div>
        <div class="stat-label">Đơn hàng</div>
        <div class="stat-value">@ViewBag.OrderCount</div>
        <p class="stat-desc">Đơn hàng đang được xử lý</p>
        <div class="stat-trend up">
            <i class="bi bi-arrow-up-right-circle-fill"></i>
            <span>+12 hôm nay</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-label">Khách hàng</div>
        <div class="stat-value">@ViewBag.CustomerCount</div>
        <p class="stat-desc">Khách hàng giao dịch</p>
        <div class="stat-trend up">
            <i class="bi bi-arrow-up-right-circle-fill"></i>
            <span>+8.2%</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <div class="stat-label">Doanh thu</div>
        <div class="stat-value">@(string.Format("{0:N0}", (decimal)ViewBag.TotalRevenue))₫</div>
        <p class="stat-desc">Tổng doanh thu</p>
        <div class="stat-trend up">
            <i class="bi bi-arrow-up-right-circle-fill"></i>
            <span>+15.3%</span>
        </div>
    </div>
</div>

<!-- Recent Products Section -->
<div class="data-table">
    <div style="padding: 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h4 style="margin: 0 0 4px 0; font-weight: 700;">Sản phẩm mới nhất</h4>
            <p style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Kiểm tra và quản lý sản phẩm trực tiếp từ API</p>
        </div>
        <a href="/admin/products" class="btn btn-primary">
            <i class="bi bi-arrow-right"></i>
            Xem tất cả
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="padding: 48px 24px; text-align: center; color: var(--color-text-muted);">
            <i class="bi bi-inbox" style="font-size: 48px; opacity: 0.5; display: block; margin-bottom: 16px;"></i>
            <p style="margin: 0;">Không có sản phẩm để hiển thị. Hãy đảm bảo API đang chạy.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Take(5))
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("N0")₫</td>
                                <td>@product.CategoryName</td>
                                <td>@product.BrandName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card admin-panel-card shadow-sm border-0 rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-semibold">Đơn hàng gần đây</h4>
                <p class="text-muted mb-0">Theo dõi những đơn mới nhất và trạng thái cập nhật.</p>
            </div>
            <a href="/admin/orders" class="btn btn-outline-light rounded-pill px-4">Xem tất cả đơn hàng</a>
        </div>

        @{
            var recentOrders = ViewBag.RecentOrders as List<AdminOrderDto> ?? new List<AdminOrderDto>();
        }

        @if (!recentOrders.Any())
        {
            <div class="alert alert-secondary">Chưa có đơn hàng mới để hiển thị.</div>
        }
        else
        {
            <div class="table-responsive dashboard-table">
                <table class="table align-middle table-dark table-admin">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Giá trị</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>Khách #@order.UserId</td>
                                <td>@order.TotalAmount.ToString("N0")₫</td>
                                <td><span class="badge badge-status badge-@order.Status.ToLower().Replace(" ", "-")">@order.Status</span></td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
