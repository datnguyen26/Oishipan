/* Admin area styles */
:root {
    color-scheme: dark;
    --primary: #3b82f6;
    --primary-light: #60a5fa;
    --primary-dark: #1e40af;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #06b6d4;
    --dark-bg: #0f172a;
    --dark-bg-light: #1e293b;
    --dark-border: rgba(148, 163, 184, 0.12);
    --text-primary: #f8fafc;
    --text-secondary: #cbd5e1;
    --text-muted: #94a3b8;
}

* {
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

body {
    background: radial-gradient(circle at top, #0f172a 0%, #08101f 45%, #02040a 100%);
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* SIDEBAR */
.admin-sidebar {
    width: 280px;
    min-height: 100vh;
    background: linear-gradient(180deg, #060b17 0%, #081025 100%);
    border-right: 1px solid var(--dark-border);
    position: sticky;
    top: 0;
    overflow-y: auto;
}

.admin-sidebar a {
    color: var(--text-secondary);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-sidebar a:hover,
.admin-sidebar a.active {
    color: #ffffff;
    background: rgba(56, 189, 248, 0.15);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
    transform: translateX(4px);
}

.admin-sidebar h4 {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 700;
}

/* TOPBAR */
.admin-topbar {
    background: rgba(12, 18, 32, 0.95);
    color: var(--text-primary);
    border-bottom: 1px solid var(--dark-border);
    min-height: 96px;
    backdrop-filter: blur(12px);
}

.admin-topbar .btn {
    border-color: rgba(148, 163, 184, 0.16);
    transition: all 0.3s ease;
}

.admin-topbar .btn:hover {
    background: rgba(56, 189, 248, 0.14);
    color: #ffffff;
    transform: translateY(-2px);
}

/* CONTENT */
.admin-content {
    padding: 2rem 2rem 3rem;
}

/* METRIC CARDS */
.metric-card,
.admin-panel-card {
    background: rgba(12, 18, 32, 0.95);
    border: 1px solid var(--dark-border);
    box-shadow: 0 28px 80px rgba(7, 14, 33, 0.25);
    border-radius: 1.75rem;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
}

.metric-card:hover {
    border-color: rgba(56, 189, 248, 0.24);
    box-shadow: 0 28px 80px rgba(56, 189, 248, 0.15);
    transform: translateY(-4px);
}

.metric-card {
    padding: 1.75rem;
    min-height: 170px;
}

.metric-label {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    font-weight: 600;
}

.metric-value {
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.5rem;
    color: #ffffff;
}

.metric-description {
    color: var(--text-muted);
    margin-bottom: 0;
    font-size: 0.875rem;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
}

/* TABLE STYLES */
.admin-panel-card .table-admin {
    border-collapse: separate;
    border-spacing: 0 0.75rem;
}

.table-admin thead tr {
    border-bottom: none;
}

.table-admin thead th {
    color: var(--text-secondary);
    border: none;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 1rem 0.75rem !important;
}

.table-admin tbody tr {
    background: rgba(15, 23, 42, 0.9);
    border-radius: 1rem;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.table-admin tbody tr:hover {
    transform: translateY(-2px);
    background: rgba(30, 41, 59, 0.95);
    border-color: rgba(56, 189, 248, 0.16);
    box-shadow: 0 8px 16px rgba(56, 189, 248, 0.1);
}

.table-admin tbody td {
    border: none;
    vertical-align: middle;
    color: var(--text-primary);
    padding: 1rem 0.75rem !important;
}

.table-admin tbody td:first-child {
    border-radius: 1rem 0 0 1rem;
}

.table-admin tbody td:last-child {
    border-radius: 0 1rem 1rem 0;
}

.text-muted {
    color: var(--text-secondary) !important;
}

/* BADGES */
.badge-outline {
    background: rgba(56, 189, 248, 0.16);
    color: #dbeafe;
    border: 1px solid rgba(56, 189, 248, 0.32);
    padding: 0.4rem 0.8rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
}

.badge-status {
    padding: 0.65rem 0.95rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    font-weight: 700;
    display: inline-block;
    transition: all 0.2s ease;
}

.badge-status:hover {
    transform: scale(1.05);
}

.badge-status.badge-đang-xử-lý,
.badge-status.badge-pending,
.badge-status.badge-chờ-xử-lý {
    background: rgba(250, 204, 21, 0.2);
    color: #facc15;
    border: 1px solid rgba(250, 204, 21, 0.3);
}

.badge-status.badge-đã-giao,
.badge-status.badge-success,
.badge-status.badge-completed {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.3);
}

.badge-status.badge-chờ-thanh-toán,
.badge-status.badge-warning {
    background: rgba(14, 165, 233, 0.2);
    color: #7dd3fc;
    border: 1px solid rgba(14, 165, 233, 0.3);
}

.badge-status.badge-huỷ,
.badge-status.badge-cancelled,
.badge-status.badge-đã-hủy {
    background: rgba(248, 113, 113, 0.2);
    color: #fca5a5;
    border: 1px solid rgba(248, 113, 113, 0.3);
}

.badge-status.badge-active,
.badge-status.badge-enabled {
    background: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge-status.badge-inactive,
.badge-status.badge-disabled {
    background: rgba(107, 114, 128, 0.2);
    color: #d1d5db;
    border: 1px solid rgba(107, 114, 128, 0.3);
}

/* ALERTS */
.admin-panel-card .alert {
    color: #e2e8f0;
    background: rgba(15, 23, 42, 0.9);
    border-color: var(--dark-border);
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--dark-border);
}

.alert-info {
    background: rgba(6, 182, 212, 0.1) !important;
    border-color: rgba(6, 182, 212, 0.2) !important;
}

.alert-success {
    background: rgba(16, 185, 129, 0.1) !important;
    border-color: rgba(16, 185, 129, 0.2) !important;
}

.alert-warning {
    background: rgba(245, 158, 11, 0.1) !important;
    border-color: rgba(245, 158, 11, 0.2) !important;
}

.alert-danger {
    background: rgba(239, 68, 68, 0.1) !important;
    border-color: rgba(239, 68, 68, 0.2) !important;
}

/* PRODUCT GRID */
.admin-product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
}

.admin-product-card {
    overflow: hidden;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.85) 100%);
    border: 1px solid var(--dark-border);
    border-radius: 1.25rem;
    transition: all 0.3s ease;
}

.admin-product-card:hover {
    border-color: rgba(56, 189, 248, 0.24);
    box-shadow: 0 12px 32px rgba(56, 189, 248, 0.15);
    transform: translateY(-4px);
}

.admin-product-card-body {
    display: grid;
    grid-template-columns: 180px 1fr;
}

.admin-product-image {
    min-height: 240px;
    background-size: cover;
    background-position: center;
    position: relative;
}

.admin-product-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 100%);
}

.admin-product-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.product-price {
    font-size: 1.6rem;
    font-weight: 700;
    color: #a5f3fc;
}

.product-description {
    color: var(--text-muted);
    min-height: 3rem;
}

/* FORMS & INPUTS */
.form-control-dark,
.form-select.form-control-dark {
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: var(--text-primary);
    border-radius: 0.75rem;
    transition: all 0.2s ease;
}

.form-control-dark:focus,
.form-select.form-control-dark:focus {
    background: rgba(15, 23, 42, 1);
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.18);
    color: var(--text-primary);
}

.admin-panel-card .form-label {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 0.75rem;
}

input[type="file"].form-control-dark,
input[type="file"].form-control {
    color: var(--text-primary);
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.22);
}

input[type="file"]::file-selector-button {
    background: rgba(56, 189, 248, 0.16);
    color: #ffffff;
    border: 1px solid rgba(56, 189, 248, 0.32);
    padding: 0.4rem 0.8rem;
    border-radius: 0.375rem;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
}

input[type="file"]::file-selector-button:hover {
    background: rgba(56, 189, 248, 0.24);
}

.form-control-dark::placeholder,
.form-select.form-control-dark option {
    color: rgba(226, 232, 240, 0.65);
}

.admin-edit-image-preview {
    width: 100%;
    min-height: 220px;
    background-size: cover;
    background-position: center;
    border-radius: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    overflow: hidden;
}

/* BUTTONS */
.btn-outline-light {
    color: #e2e8f0;
    border-color: rgba(226, 232, 240, 0.24);
    transition: all 0.2s ease;
}

.btn-outline-light:hover {
    background: rgba(226, 232, 240, 0.12);
    border-color: rgba(226, 232, 240, 0.4);
    transform: translateY(-2px);
}

.btn-outline-secondary {
    color: #e2e8f0;
    border-color: rgba(148, 163, 184, 0.24);
    transition: all 0.2s ease;
}

.btn-outline-secondary:hover {
    background: rgba(148, 163, 184, 0.12);
    color: #ffffff;
    transform: translateY(-2px);
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    border: none;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(56, 189, 248, 0.3);
}

.btn-success {
    background: linear-gradient(135deg, var(--success) 0%, #34d399 100%);
    border: none;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(16, 185, 129, 0.3);
}

.btn-danger {
    background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
    border: none;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(239, 68, 68, 0.3);
}

.btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
}

/* MODAL STYLES */
.modal-content {
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid var(--dark-border);
}

.modal-header {
    border-color: var(--dark-border);
}

.modal-footer {
    border-color: var(--dark-border);
}

.close {
    color: var(--text-primary);
}

/* LOADING STATE */
.loading {
    position: relative;
    opacity: 0.6;
    pointer-events: none;
}

.spinner-border {
    color: var(--primary);
}

/* SEARCH & FILTER */
.search-box {
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--text-primary);
}

.search-box::placeholder {
    color: rgba(226, 232, 240, 0.65);
}

.search-box:focus {
    outline: none;
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.18);
}

/* PAGINATION */
.pagination .page-link {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--dark-border);
    color: var(--text-primary);
    transition: all 0.2s ease;
}

.pagination .page-link:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: rgba(56, 189, 248, 0.24);
    color: #ffffff;
}

.pagination .page-item.active .page-link {
    background: var(--primary);
    border-color: var(--primary);
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .admin-sidebar {
        width: 100%;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .admin-topbar {
        min-height: auto;
    }

    .admin-content {
        padding: 1.25rem;
    }

    .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .admin-product-grid {
        grid-template-columns: 1fr;
    }

    .admin-product-card-body {
        grid-template-columns: 1fr;
    }

    .admin-product-image {
        min-height: 160px;
    }
}

@media (max-width: 576px) {
    .admin-sidebar {
        min-height: auto;
    }

    .admin-sidebar .nav {
        flex-direction: row;
        overflow-x: auto;
    }

    .admin-sidebar .nav-link {
        white-space: nowrap;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .metric-card {
        min-height: auto;
    }

    .metric-value {
        font-size: 2rem;
    }

    .admin-content {
        padding: 1rem;
    }

    .table-admin tbody td {
        padding: 0.75rem 0.5rem !important;
        font-size: 0.875rem;
    }

    .table-admin thead th {
        padding: 0.75rem 0.5rem !important;
        font-size: 0.7rem;
    }
}
