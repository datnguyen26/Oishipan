@{
    ViewData["Title"] = "Thêm thương hiệu mới";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold">Thêm thương hiệu mới</h4>
            <p class="text-muted mb-0">Tạo thương hiệu mới để gán cho sản phẩm.</p>
        </div>
        <a href="/admin/brands" class="btn btn-outline-light rounded-pill">Quay lại danh sách</a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card admin-panel-card shadow-sm rounded-4 p-4">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Tên thương hiệu</label>
                <input type="text" name="brandName" class="form-control form-control-dark" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Mô tả</label>
                <input type="text" name="description" class="form-control form-control-dark" />
            </div>
            <button type="submit" class="btn btn-success rounded-pill px-4">Tạo thương hiệu</button>
        </form>
    </div>
</div>