@model IEnumerable<OishipanMVC.Models.ProductViewModel>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold">Danh sách sản phẩm</h4>
            <p class="text-muted mb-0">Quản lý sản phẩm hiện có và đánh giá trạng thái.</p>
        </div>
        <a href="/admin" class="btn btn-outline-secondary rounded-pill">Quay lại Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">Chưa có sản phẩm nào. Vui lòng kiểm tra API hoặc thêm sản phẩm mới.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm rounded-4 overflow-hidden">
                        <div class="row g-0">
                            <div class="col-sm-4">
                                <img src="@product.ImageUrl" class="img-fluid h-100 object-fit-cover" alt="@product.Name" />
                            </div>
                            <div class="col-sm-8">
                                <div class="card-body">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="text-muted mb-2">@product.CategoryName - @product.BrandName</p>
                                    <p class="text-success fw-bold mb-2">@product.Price.ToString("N0")₫</p>
                                    <p class="text-muted small">@product.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="badge bg-success">Còn @product.Quantity</span>
                                        <button class="btn btn-outline-primary btn-sm rounded-pill">Chỉnh sửa</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
