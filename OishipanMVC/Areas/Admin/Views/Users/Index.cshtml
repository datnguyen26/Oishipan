@model List<OishipanMVC.Models.UserViewModel>

@{
    ViewData["Title"] = "Người dùng";
}

<!-- Search & Filter Control Panel -->
<div class="data-table" style="margin-bottom: 32px; padding: 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div class="flex" style="display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 300px;">
        <!-- Search Field -->
        <div style="position: relative; width: 100%;">
            <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--color-text-muted);"></i>
            <form method="get" action="/admin/users" style="display: flex; gap: 8px;">
                <input 
                    type="text" 
                    name="search"
                    placeholder="Tìm kiếm người dùng..." 
                    class="form-control"
                    value="@ViewBag.SearchTerm"
                    style="padding-left: 40px; flex: 1;"
                />
                <button type="submit" class="btn btn-primary">Tìm</button>
            </form>
        </div>
    </div>

    <!-- Add button -->
    <a href="/admin/users/create" class="btn btn-success" style="align-self: flex-start; margin-top: 8px;">
        <i class="bi bi-plus-lg"></i>
        Thêm người dùng
    </a>
</div>

<!-- Users Table -->
<div class="data-table">
    <div style="padding: 24px; border-bottom: 1px solid var(--color-border);">
        <h4 style="margin: 0 0 4px 0; font-weight: 700;">Danh sách người dùng</h4>
        <p style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Quản lý tất cả người dùng trong hệ thống</p>
    </div>

    @if (!Model.Any())
    {
        <div style="padding: 48px 24px; text-align: center; color: var(--color-text-muted);">
            <i class="bi bi-inbox" style="font-size: 48px; opacity: 0.5; display: block; margin-bottom: 16px;"></i>
            <p style="margin: 0;">Không có người dùng để hiển thị.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid var(--color-border);">
                        <th style="padding: 16px 20px; text-align: left; font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Tên người dùng</th>
                        <th style="padding: 16px 20px; text-align: left; font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Email</th>
                        <th style="padding: 16px 20px; text-align: left; font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Vai trò</th>
                        <th style="padding: 16px 20px; text-align: left; font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Trạng thái</th>
                        <th style="padding: 16px 20px; text-align: center; font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Hành động</th>
                    </tr>
                </thead>
                <tbody style="border: none;">
                    @foreach (var u in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--color-border); background: transparent; transition: all 0.3s ease;">
                            <td style="padding: 16px 20px; color: var(--color-text-primary);">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <img src="https://ui-avatars.com/api/?name=@System.Net.WebUtility.UrlEncode(u.FullName)&background=7c3aed&color=fff&size=128" alt="Avatar" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;" />
                                    <div>
                                        <p style="margin: 0; font-weight: 600; font-size: 14px;">@u.FullName</p>
                                        <p style="margin: 0; font-size: 12px; color: var(--color-text-muted);">@u.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 16px 20px; color: var(--color-text-secondary);">@u.Email</td>
                            <td style="padding: 16px 20px;">
                                <span class="badge" style="background: rgba(124, 58, 237, 0.12); color: var(--color-brand-primary);">@u.Role</span>
                            </td>
                            <td style="padding: 16px 20px;">
                                @if (u.Status)
                                {
                                    <span class="badge badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Bị khoá</span>
                                }
                            </td>
                            <td style="padding: 16px 20px; text-align: center;">
                                <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                    <a href="/admin/users/edit/@u.UserId" class="btn btn-sm btn-outline-light">Sửa</a>
                                    <form method="post" action="/admin/users/delete/@u.UserId" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
