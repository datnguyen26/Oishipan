@using System.Text.Json
@{
    Layout = null;
    var profile = new
    {
        id = User.FindFirst("sub")?.Value ?? User.FindFirst("nameidentifier")?.Value ?? "ND001",
        name = User.Identity?.Name ?? "Admin Oishipan",
        nickname = (User.Identity?.Name ?? "Admin").Split(' ').Last(),
        email = User.FindFirst("email")?.Value ?? User.Identity?.Name ?? "admin@oishipan.vn",
        role = User.IsInRole("Admin") ? "admin" : User.IsInRole("Staff") ? "staff" : "user",
        status = "Hoạt động",
        avatar = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80",
        joinDate = DateTime.Now.ToString("dd-MM-yyyy"),
        actionsCount = 142
    };
    
    var apiToken = Context.Session.GetString("ApiToken") ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oishipan Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        window.adminInitialProfile = @Html.Raw(JsonSerializer.Serialize(profile));
        window.adminApiToken = '@apiToken';
    </script>
    <script>
        // Development API base for SPA to reach the backend API project
        window.adminApiBase = 'http://localhost:8080';
    </script>
</head>
<body class="min-h-screen bg-stone-50 text-stone-800">
    <div id="admin-root" class="min-h-screen">@RenderBody()</div>
    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
    <script src="https://unpkg.com/%40babel/standalone/babel.min.js"></script>
    <script src="~/js/admin-api.js" asp-append-version="true"></script>
    <script type="text/babel" src="~/js/admin-app.jsx" data-type="module"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
