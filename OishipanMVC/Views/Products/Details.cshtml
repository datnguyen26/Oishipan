@model OishipanMVC.Models.ProductViewModel

@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
}

<div class="container py-5">
    @if (Model == null)
    {
        <div class="alert alert-warning">
            Sản phẩm không tồn tại hoặc đã bị xóa. <a href="/san-pham" class="alert-link">Quay lại menu</a>.
        </div>
    }
    else
    {
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="product-detail-image overflow-hidden rounded-4 shadow-sm">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid w-100">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="mb-4">
                    <a href="/san-pham" class="text-success text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại menu</a>
                </div>
                <h1 class="fw-bold mb-3">@Model.Name</h1>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-success">@Model.CategoryName</span>
                    <span class="badge bg-secondary">@Model.BrandName</span>
                </div>
                <p class="text-muted mb-4">@Model.Description</p>
                <div class="mb-4">
                    <span class="h2 text-success fw-bold">@Model.Price.ToString("N0")₫</span>
                    <span class="text-muted ms-3">Còn lại: @Model.Quantity</span>
                </div>
                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a href="/san-pham" class="btn btn-outline-success rounded-pill px-4 py-3">Tiếp tục mua</a>
                    <button type="button" class="btn btn-success rounded-pill px-4 py-3">Thêm vào giỏ</button>
                </div>
            </div>
        </div>
    }
</div>
