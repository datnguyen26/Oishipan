@{
    var homeUrl = Url.Action("Index", "Home");
    var productsUrl = Url.Action("Index", "Products");
    var logoutUrl = Url.Action("Logout", "Account");
    var loginUrl = Url.Action("Login", "Account");
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container-custom d-flex align-items-center justify-content-between gap-3">
        <a class="navbar-brand" href="/">Oishipan</a>

        <ul class="navbar-nav d-flex flex-row align-items-center gap-3 mb-0">
            <li class="nav-item">
                <a class="nav-link active" href="@homeUrl">Trang chủ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link spa-link" href="@productsUrl">Menu bánh</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/ve-oishipan">Về Oishipan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/lien-he">Liên hệ</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/tin-tuc">Tin tức</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/chinh-sach">Chính sách</a>
            </li>
        </ul>

        <div class="header-actions d-flex align-items-center gap-3">
            <a href="@productsUrl" class="cart-btn position-relative">
                <i class="bi bi-cart3"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">0</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="me-3 text-success fw-semibold">Xin chào, @User.Identity.Name</span>
                <a href="@logoutUrl" class="btn-login">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </a>
            }
            else
            {
                <a href="@loginUrl" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </a>
            }
        </div>
    </div>
</nav>
