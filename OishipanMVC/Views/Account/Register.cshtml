@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container auth-page py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="mb-4 text-center">
                        <h2 class="fw-bold">Tạo tài khoản mới</h2>
                        <p class="text-muted">Hãy tạo tài khoản để nhận ưu đãi và đặt bánh dễ dàng hơn.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Lỗi!</strong> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Success))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Thành công!</strong> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" action="/dang-ky" id="registerForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="fullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-4" id="fullName" name="fullName" placeholder="Nhập họ tên" required minlength="3" maxlength="100">
                                <small class="text-danger" id="fullNameError"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control rounded-4" id="email" name="email" placeholder="Nhập email" required>
                                <small class="text-danger" id="emailError"></small>
                            </div>
                        </div>

                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label for="phoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control rounded-4" id="phoneNumber" name="phoneNumber" placeholder="Nhập số điện thoại (10 chữ số)" required pattern="0[0-9]{9}">
                                <small class="text-muted">Bắt đầu bằng 0 và có 10 chữ số</small>
                                <small class="text-danger" id="phoneError"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="password" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                                <input type="password" class="form-control rounded-4" id="password" name="password" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" required minlength="6" maxlength="100">
                                <small class="text-danger" id="passwordError"></small>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label for="address" class="form-label fw-semibold">Địa chỉ <span class="text-danger">*</span></label>
                            <textarea class="form-control rounded-4" id="address" name="address" rows="3" placeholder="Nhập địa chỉ giao hàng" required maxlength="200"></textarea>
                            <small class="text-danger" id="addressError"></small>
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill py-3 mt-4 fw-semibold" id="submitBtn">
                            <span id="btnText">Đăng ký</span>
                            <span id="spinner" class="spinner-border spinner-border-sm ms-2" style="display: none;"></span>
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <span class="text-muted">Đã có tài khoản? </span>
                        <a href="/dang-nhap" class="text-success fw-semibold text-decoration-none">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/register-validation.js"></script>
