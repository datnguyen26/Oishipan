@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container auth-page py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="mb-4 text-center">
                        <h2 class="fw-bold">Đăng nhập</h2>
                        <p class="text-muted">Đăng nhập để tiếp tục xem menu và đặt hàng nhanh chóng.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/dang-nhap">
                        <div class="mb-4">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control rounded-4" id="email" name="email" placeholder="Nhập email" required>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control rounded-4" id="password" name="password" placeholder="Nhập mật khẩu" required>
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill py-3">Đăng nhập</button>
                    </form>

                    <div class="mt-4 text-center">
                        <span class="text-muted">Chưa có tài khoản? </span>
                        <a href="/dang-ky" class="text-success fw-semibold">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
