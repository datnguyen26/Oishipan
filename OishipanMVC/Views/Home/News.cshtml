@{
    ViewData["Title"] = "Tin tức Oishipan";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-5">
                <h1 class="fw-bold mb-4">Tin tức &amp; Cập nhật</h1>
                <p class="text-muted">Cập nhật xu hướng bánh mới nhất, sự kiện ưu đãi và những câu chuyện đặc biệt từ Oishipan.</p>

                <div class="news-item mt-5">
                    <h4 class="fw-semibold">Ưu đãi mùa hè: Giảm giá đến 20%</h4>
                    <p class="text-muted">Từ hôm nay, Oishipan dành ưu đãi đặc biệt cho các đơn hàng bánh ngọt mùa hè. Đăng ký nhận tin để không bỏ lỡ.</p>
                </div>

                <div class="news-item mt-4">
                    <h4 class="fw-semibold">Bánh mới: Matcha latte cheesecake</h4>
                    <p class="text-muted">Thưởng thức món bánh mới với hương matcha đậm đà và lớp kem phô mai mịn, phù hợp cho mọi buổi tiệc nhỏ.</p>
                </div>

                <div class="news-item mt-4">
                    <h4 class="fw-semibold">Giao hàng nhanh hôm sau nội thành</h4>
                    <p class="text-muted">Oishipan cập nhật dịch vụ giao hàng trong ngày cho đơn hàng nội thành TP.HCM.</p>
                </div>

                <div class="mt-5 text-center">
                    <a href="@Url.Action("Index", "Products")" class="btn btn-success rounded-pill px-5 py-3">Xem Menu Bánh</a>
                </div>
            </div>
        </div>
    </div>
</div>
