@{
    ViewData["Title"] = "Chính sách Oishipan";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-5">
                <h1 class="fw-bold mb-4">Chính sách bảo mật và điều khoản sử dụng</h1>
                <p class="text-muted">Oishipan cam kết bảo vệ thông tin cá nhân và đảm bảo trải nghiệm mua sắm an toàn cho khách hàng.</p>
                <div class="mt-4">
                    <h4 class="fw-semibold">1. Bảo mật thông tin</h4>
                    <p class="text-muted">Chúng tôi thu thập và sử dụng thông tin cá nhân chỉ nhằm mục đích xử lý đơn hàng, chăm sóc khách hàng và cung cấp dịch vụ tốt hơn.</p>
                </div>
                <div class="mt-4">
                    <h4 class="fw-semibold">2. Điều khoản sử dụng</h4>
                    <p class="text-muted">Khi sử dụng trang web Oishipan, bạn đồng ý tuân thủ các quy định về đặt hàng, thanh toán và chính sách đổi trả do chúng tôi đề ra.</p>
                </div>
                <div class="mt-4">
                    <h4 class="fw-semibold">3. Giao hàng và đổi trả</h4>
                    <p class="text-muted">Oishipan hỗ trợ giao hàng nhanh và chính sách đổi trả rõ ràng cho các sản phẩm lỗi hoặc không đúng cam kết.</p>
                </div>
                <div class="mt-5 text-center">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-success rounded-pill px-5 py-3">Quay về Trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div>
