<section id="about" class="container-custom py-5">
    <div class="brand-story">
        <div class="row align-items-center g-5 px-lg-5">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&q=80&w=1200" class="img-fluid story-img" alt="Bếp bánh Oishipan">
            </div>
            <div class="col-lg-6">
                <h6 class="text-success fw-bold text-uppercase mb-3" style="letter-spacing: 2px;">Về Oishipan</h6>
                <h2 class="display-5 fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Oishipan - Bánh Nhật cao cấp, tinh tế từng chi tiết</h2>
                <p class="text-muted mb-4" style="line-height: 1.8;">Oishipan là tiệm bánh chuyên phục vụ các loại bánh nhập khẩu từ Nhật Bản với chất lượng cao nhất. Chúng tôi cam kết mang đến cho khách hàng những sản phẩm tươi ngon, an toàn và đáng tin cậy.</p>
                <p class="text-muted mb-4" style="line-height: 1.8;">Với hơn 5 năm kinh nghiệm trong ngành, Oishipan đã phục vụ hàng ngàn khách hàng thân thiết và luôn nhận được lời khen từ cộng đồng.</p>
                <div class="row g-3 mt-4">
                    <div class="col-sm-4">
                        <div class="info-card p-4 rounded-4">
                            <h5 class="fw-bold">Sản phẩm chất lượng cao</h5>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-card p-4 rounded-4">
                            <h5 class="fw-bold">Giao hàng nhanh chóng</h5>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-card p-4 rounded-4">
                            <h5 class="fw-bold">Dịch vụ khách hàng 24/7</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="py-5 bg-white">
    <div class="container-custom">
        <div class="section-header">
            <h3>Liên hệ với chúng tôi</h3>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="contact-card p-5 rounded-4">
                    <h4 class="fw-bold mb-4">Oishipan Bakery</h4>
                    <p class="text-muted mb-4">Cần hỗ trợ đặt bánh hoặc tư vấn thực đơn? Chúng tôi sẵn sàng đồng hành cùng sự kiện của bạn.</p>
                    <div class="mb-3">
                        <h6 class="fw-semibold">Địa chỉ</h6>
                        <p class="mb-0 text-muted">123 Đường Nguyễn Trãi, Quận 1, TP.HCM</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-semibold">Điện thoại</h6>
                        <p class="mb-0 text-muted">(84+) 123 456 789</p>
                    </div>
                    <div>
                        <h6 class="fw-semibold">Email</h6>
                        <p class="mb-0 text-muted">contact@oishipan.com</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-card p-5 rounded-4 h-100 d-flex flex-column justify-content-center">
                    <h4 class="fw-bold mb-3">Đặt hàng ngay hôm nay</h4>
                    <p class="text-muted mb-4">Hãy để chúng tôi chuẩn bị món bánh hoàn hảo cho ngày kỷ niệm, sinh nhật hoặc quà tặng đặc biệt.</p>
                    <a href="mailto:contact@oishipan.com" class="btn btn-login px-4 py-3 rounded-pill">Gửi yêu cầu</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="toast-container">
    <div id="cartToast" class="custom-toast">
        <i class="bi bi-check2-circle me-2"></i> Đã thêm vào giỏ hàng thành công!
    </div>
</div>

@section Scripts {
    <script>
        let cartCount = 0;

        function addToCart(productName) {
            cartCount++;
            const badge = document.querySelector('.cart-btn .badge');
            if (badge) {
                badge.innerText = cartCount;
            }

            const toast = document.getElementById('cartToast');
            if (!toast) return;

            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 3000);
        }

        window.addEventListener('scroll', function() {
            const nav = document.querySelector('.navbar');
            if (!nav) return;
            if (window.pageYOffset > 50) {
                nav.style.boxShadow = '0 5px 20px rgba(0,0,0,0.05)';
                nav.style.padding = '0.5rem 0';
            } else {
                nav.style.boxShadow = 'none';
                nav.style.padding = '0.8rem 0';
            }
        });
    </script>
}
