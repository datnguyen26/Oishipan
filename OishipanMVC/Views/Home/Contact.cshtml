@{
    ViewData["Title"] = "Liên hệ";
}

<section class="container-custom py-5">
    <div class="row gy-4">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold">Liên hệ với Oishipan</h1>
            <p class="lead text-muted">Chúng tôi luôn sẵn sàng hỗ trợ bạn. Hãy gửi yêu cầu và đội ngũ sẽ phản hồi trong thời gian sớm nhất.</p>
            <div class="border rounded-4 p-4 bg-white shadow-sm">
                <h3 class="fw-semibold">Thông tin liên hệ</h3>
                <p class="mb-2"><strong>Email:</strong> <a href="mailto:contact@oishipan.com">contact@oishipan.com</a></p>
                <p class="mb-2"><strong>Hotline:</strong> <a href="tel:0123456789">0123 456 789</a></p>
                <p class="mb-2"><strong>Địa chỉ:</strong> 123 Đường Bánh Ngọt, Quận 1, TP.HCM</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-5 rounded-4 bg-light shadow-sm">
                <form>
                    <div class="mb-4">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" class="form-control" placeholder="Nhập họ tên" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="Nhập email" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Nội dung</label>
                        <textarea class="form-control" rows="5" placeholder="Nội dung liên hệ"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success rounded-pill px-4 py-3">Gửi yêu cầu</button>
                </form>
            </div>
        </div>
    </div>
</section>
